# Application Server
PORT=3000
NODE_ENV=development

# Public App URL & Metadata
VITE_APP_URL=http://localhost:3000
VITE_SITE_NAME="OmniMetrics AI Solutions Inc."

# Optional: External Contact / Form Submission Endpoint
# VITE_CONTACT_FORM_ENDPOINT=https://api.omnimetrics.ai/v1/contact

# Optional: Analytics & Telemetry (if configured)
# VITE_ANALYTICS_ID=
